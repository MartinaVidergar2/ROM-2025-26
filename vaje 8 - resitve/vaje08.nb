      RowBox[{
       RowBox[{"IndeksStolpca", "[", 
        RowBox[{"podatki", ",", "stolpec"}], "]"}], " ", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"indeks", "===", "Null"}], ",", "Null", ",", 
         RowBox[{
          RowBox[{"Transpose", "[", "vseVrednosti", "]"}], "[", 
          RowBox[{"[", "indeks", "]"}], "]"}]}], "]"}]}]}]}]}], 
   "]"}]}]], "Input",
