643315a0a99b"],

Cell[TextData[{
 StyleBox["1. a)",
  FontWeight->"Bold"],
 " Z ukazom \[OpenCurlyQuote]Directory\[CloseCurlyQuote] preveri delovno \
podro\[CHacek]je. Nato z uporabo \[OpenCurlyQuote]SetDirectory\
\[CloseCurlyQuote] in \[OpenCurlyQuote]NotebookDirectory\[CloseCurlyQuote] \
nastavi delovno podro\[CHacek]je na ustrezno mapo. "
}], "Text",
 CellChangeTimes->{{3.985147536009978*^9, 3.9851476054689465`*^9}, {
  3.98523957599275*^9, 
  3.985239589442259*^9}},ExpressionUUID->"b282c310-1783-44a0-b5cc-\
4217572a8639"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SetDirectory", "[", 
   RowBox[{"NotebookDirectory", "[", "]"}], "]"}], ";"}], "\n", 
 RowBox[{"Directory", "[", "]"}]}], "Input",
 CellChangeTimes->{{3.985364497564581*^9, 3.985364497564581*^9}},
