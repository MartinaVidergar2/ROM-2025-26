Cell[BoxData[
 RowBox[{
  RowBox[{"IndeksStolpca", "[", 
   RowBox[{"podatki_", ",", "stolpec_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"imena", ",", "pozicija"}], "}"}], ",", 
    RowBox[{"imena", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"Imena", "[", "podatki", "]"}], " ", "pozicija"}], "=", 
      RowBox[{
       RowBox[{"Position", "[", 
        RowBox[{"imena", ",", "stolpec"}], "]"}], " ", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Length", "[", "pozicija", "]"}], ">", "0"}], ",", 
         RowBox[{"pozicija", "[", 
          RowBox[{"[", 
           RowBox[{"1", ",", "1"}], "]"}], "]"}], ",", "Null"}], 
        "]"}]}]}]}]}], "]"}]}]], "Input",
