Cell[BoxData[
 RowBox[{
  RowBox[{"Stolpec", "[", 
   RowBox[{"podatki_", ",", "stolpec_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"vseVrednosti", ",", "indeks"}], "}"}], ",", 
    RowBox[{"vseVrednosti", "=", 
     RowBox[{
      RowBox[{
