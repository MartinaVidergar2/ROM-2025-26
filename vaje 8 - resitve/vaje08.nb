  RowBox[{"Ocene", "[", 
   RowBox[{"podatki_", ",", "meje_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "tocke", "}"}], ",", 
    RowBox[{"tocke", "=", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"Stolpec", "[", 
         RowBox[{"podatki", ",", "\"\<Tocke\>\""}], "]"}], " ", 
        RowBox[{"OcenaZaMeje", "[", 
         RowBox[{"meje", ",", "#"}], "]"}]}], "&"}], "/@", "tocke"}]}]}], 
   "]"}]}]], "Input",
